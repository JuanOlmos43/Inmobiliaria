// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// USUARIOS Y AUTENTICACIÓN
// ============================================

enum UserRole {
  admin
  agent
  landlord // Propietario
  tenant // Inquilino
}

enum UserStatus {
  active
  inactive
  suspended
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  password  String // Hash de la contraseña
  name      String?
  phone     String?
  role      UserRole
  status    UserStatus @default(active)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Relaciones
  propertiesOwned           Property[]       @relation("PropertyOwner")
  propertiesManaged         Property[]       @relation("PropertyAgent")
  rentalContractsAsTenant   RentalContract[] @relation("TenantContracts")
  rentalContractsAsLandlord RentalContract[] @relation("LandlordContracts")
  rentalContractsAsAgent    RentalContract[] @relation("AgentContracts")
}

// ============================================
// UBICACIONES (Jerarquía geográfica)
// ============================================

model Provincia {
  id          String      @id @default(uuid())
  nombre      String      @unique
  localidades Localidad[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Localidad {
  id          String     @id @default(uuid())
  nombre      String
  provincia   Provincia  @relation(fields: [provinciaId], references: [id], onDelete: Cascade)
  provinciaId String
  calles      Calle[]
  properties  Property[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([nombre, provinciaId])
}

model Calle {
  id          String     @id @default(uuid())
  nombre      String
  localidad   Localidad  @relation(fields: [localidadId], references: [id], onDelete: Cascade)
  localidadId String
  properties  Property[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([nombre, localidadId])
}

// ============================================
// PROPIEDADES
// ============================================

enum PropertyType {
  casa
  departamento
  terreno
  duplex
  monoambiente
  local_comercial
  oficina
}

enum PropertyListingType {
  venta
  alquiler
}

enum PropertyStatus {
  activa
  pausada
  alquilada
  vendida
  archivada
}

model Property {
  id           String              @id @default(uuid())
  title        String
  description  String?             @db.Text
  propertyType PropertyType
  listingType  PropertyListingType // venta o alquiler
  status       PropertyStatus      @default(activa)
  price        Float // Puede ser precio de venta o alquiler mensual

  // Características físicas
  bedrooms  Int   @default(0)
  bathrooms Int   @default(0)
  area      Float // Área en m²
  yearBuilt Int?

  // Ubicación
  address      String? // Dirección específica (ej: "272" de "Blas Parera 272")
  calle        Calle?     @relation(fields: [calleId], references: [id])
  calleId      String?
  localidad    Localidad? @relation(fields: [localidadId], references: [id])
  localidadId  String?
  locationText String? // Texto libre para ubicaciones (ej: "López Jordán y Carlos Darwin")

  // Multimedia
  mainImage String? // URL de la imagen principal
  images    PropertyImage[]

  // Características adicionales
  features PropertyFeature[]

  // Relaciones de propiedad y gestión
  owner   User?   @relation("PropertyOwner", fields: [ownerId], references: [id])
  ownerId String?
  agent   User?   @relation("PropertyAgent", fields: [agentId], references: [id])
  agentId String?

  // Contratos de alquiler
  rentalContracts RentalContract[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([listingType])
  @@index([propertyType])
  @@index([localidadId])
}

model PropertyImage {
  id         String   @id @default(uuid())
  url        String
  order      Int      @default(0)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String
  createdAt  DateTime @default(now())

  @@index([propertyId])
}

model PropertyFeature {
  id         String   @id @default(uuid())
  name       String // Ej: "Cochera para 2 vehículos", "Patio amplio"
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String
  createdAt  DateTime @default(now())

  @@index([propertyId])
}

// ============================================
// CONTRATOS DE ALQUILER
// ============================================

enum ContractStatus {
  active // Contrato activo
  expiring // Por vencer (próximos 30 días)
  expired // Vencido
  terminated // Terminado anticipadamente
  renewed // Renovado
}

model RentalContract {
  id String @id @default(uuid())

  // Propiedad
  property   Property @relation(fields: [propertyId], references: [id])
  propertyId String

  // Partes del contrato
  tenant     User    @relation("TenantContracts", fields: [tenantId], references: [id])
  tenantId   String
  landlord   User    @relation("LandlordContracts", fields: [landlordId], references: [id])
  landlordId String
  agent      User?   @relation("AgentContracts", fields: [agentId], references: [id])
  agentId    String?

  // Términos económicos
  monthlyRent          Float
  deposit              Float? // Depósito de garantía
  adjustmentPercentage Float? // Porcentaje de ajuste

  // Fechas
  startDate          DateTime
  endDate            DateTime
  nextAdjustmentDate DateTime?
  actualEndDate      DateTime? // Fecha real de finalización (si terminó antes)

  // Estado
  status ContractStatus @default(active)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([endDate])
  @@index([tenantId])
  @@index([landlordId])
}
