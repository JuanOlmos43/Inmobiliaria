# Direct connection to the database. Used for migrations
DIRECT_URL="postgresql://postgres.ohxnsqyjcocbaeyqybpn:[YOUR-PASSWORD]@aws-1-sa-east-1.pooler.supabase.com:5432/postgres"


# Server Configuration
PORT=3001
FRONTEND_URL=http://localhost:3000

# Node Environment
NODE_ENV=development
